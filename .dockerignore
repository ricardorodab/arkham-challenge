# Deny by default: local credentials, Git history, datasets, state, tests,
# documentation archives and installed dependencies never enter the build context.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!requirements.txt
!package.json
!package-lock.json
!README.md
!LICENSE
!LICENSE.*
!src/
!src/outage_explorer/
!src/outage_explorer/analytics/
!src/outage_explorer/analytics/contracts/
!src/outage_explorer/analytics/sql/
!src/outage_explorer/data/
!src/outage_explorer/query/
!src/outage_explorer/frontend/
!src/outage_explorer/frontend/editor/
!src/outage_explorer/frontend/locales/
!src/outage_explorer/frontend/locales/es/
!src/outage_explorer/frontend/locale/
!src/outage_explorer/frontend/locale/es/
!src/outage_explorer/frontend/locale/es/LC_MESSAGES/
!src/outage_explorer/frontend/static/
!src/outage_explorer/frontend/static/outage_explorer/
!src/outage_explorer/frontend/templates/
!src/outage_explorer/frontend/templates/outage_explorer/
!src/outage_explorer/sandbox/
!src/outage_explorer/service/
!src/outage_explorer/service/management/
!src/outage_explorer/service/management/commands/
!src/outage_explorer/service/migrations/
!src/outage_explorer/web/
# Re-exclude descendants after the directory traversal exceptions. Docker applies
# a directory exception to its children, so only the file rules below may admit bytes.
src/**
!src/outage_explorer/**/*.py
!src/outage_explorer/analytics/contracts/*.json
!src/outage_explorer/service/openapi.json
!src/outage_explorer/analytics/sql/*.sql
!src/outage_explorer/sandbox/*.cjs
!src/outage_explorer/sandbox/*.wasm
!src/outage_explorer/sandbox/PROVENANCE.md
!src/outage_explorer/sandbox/LICENSE.duckdb
!src/outage_explorer/frontend/templates/outage_explorer/*.html
!src/outage_explorer/frontend/static/outage_explorer/*.js
!src/outage_explorer/frontend/static/outage_explorer/*.css
!src/outage_explorer/frontend/static/outage_explorer/*.svg
!src/outage_explorer/frontend/static/outage_explorer/*.LICENSE.txt
!src/outage_explorer/frontend/editor/*.js
!src/outage_explorer/frontend/locales/es/*.json
!src/outage_explorer/frontend/locale/es/LC_MESSAGES/*.mo
**/__pycache__/
**/__pycache__/**
**/*.py[cod]
**/.env*
**/key.txt
**/local-config.json
**/private/
**/private/**
**/.service/
**/.service/**
