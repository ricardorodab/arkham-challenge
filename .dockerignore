# Deny by default: local credentials, Git history, datasets, state, tests,
# documentation archives and installed dependencies never enter the build context.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!requirements.txt
!package.json
!package-lock.json
!README.md
!LICENSE
!LICENSE.*
!src/
!src/outage_explorer/
!src/outage_explorer/contracts/
!src/outage_explorer/frontend/
!src/outage_explorer/frontend/static/
!src/outage_explorer/frontend/static/outage_explorer/
!src/outage_explorer/frontend/templates/
!src/outage_explorer/frontend/templates/outage_explorer/
!src/outage_explorer/sandbox/
!src/outage_explorer/service/
!src/outage_explorer/service/management/
!src/outage_explorer/service/management/commands/
!src/outage_explorer/service/migrations/
!src/outage_explorer/sql/
!src/outage_explorer/web/
!src/outage_explorer/**/*.py
!src/outage_explorer/contracts/*.json
!src/outage_explorer/service/openapi.json
!src/outage_explorer/sql/*.sql
!src/outage_explorer/sandbox/*.cjs
!src/outage_explorer/sandbox/*.wasm
!src/outage_explorer/sandbox/PROVENANCE.md
!src/outage_explorer/sandbox/LICENSE.duckdb
!src/outage_explorer/frontend/templates/outage_explorer/*.html
!src/outage_explorer/frontend/static/outage_explorer/*.js
!src/outage_explorer/frontend/static/outage_explorer/*.css
!src/outage_explorer/frontend/static/outage_explorer/*.svg
**/__pycache__/
**/*.py[cod]
**/.env*
**/key.txt
**/local-config.json
**/private/
**/.service/
