# Set this in the process environment. This file is documentation, not auto-loaded.
# Only ingestion / the separate refresh worker needs the upstream credential.
EIA_API_KEY=replace-with-your-own-eia-key

# Advanced Django setup. The explicit web.local init/serve/worker commands instead
# generate and load private local Django/demo configuration under .service/.
OUTAGE_DJANGO_SECRET_KEY=set-a-random-secret-at-runtime
OUTAGE_PROJECT_DIR=.
OUTAGE_DATA_DIR=./data
OUTAGE_STATE_DIR=./.service
OUTAGE_LOCAL_HTTP=1
OUTAGE_DJANGO_DEBUG=0

# seed_users requires all three; no committed or printed default passwords.
OUTAGE_VIEWER_PASSWORD=replace-with-an-independent-strong-password
OUTAGE_ANALYST_PASSWORD=replace-with-an-independent-strong-password
OUTAGE_ADMIN_PASSWORD=replace-with-an-independent-strong-password

# Trusted server configuration, useful for installed wheels outside project cwd.
OUTAGE_SANDBOX_NODE_MODULES=./node_modules
